    "light_editor>=0.1.0",
    "catalog_export>=0.1.0"
  ],
  "test_suites": [
    {
      "id": "windows",
      "activate": [
        "--itest=tools_windows"
      ]
    },
    {
      "id": "novel_flow",
      "activate": [
        "--itest=novel_flow"
      ]
    }
  ]
}
